#!/usr/bin/env bash

# Ensure dependencies are installed
if ! command -v brew &> /dev/null; then
    echo "Error: Homebrew (brew) is not installed." >&2
    exit 1
fi

if ! command -v fzf &> /dev/null; then
    echo "Error: fzf is not installed. Install it using: brew install fzf" >&2
    exit 1
fi

echo "Fetching Homebrew formulae and casks..."

# Combine formulae and casks into a single list
packages=$(({ brew formulae; brew casks; } 2>/dev/null) | fzf -m \
    --prompt="Select packages (TAB to multi-select) > " \
    --header="ENTER: Install selected | TAB: Toggle selection | ESC: Exit" \
    --preview="brew info {}" \
    --preview-window=right:50%:wrap)

# Exit if no packages were selected
if [ -z "$packages" ]; then
    echo "No packages selected."
    exit 0
fi

# Show selected packages
echo -e "\nPackages to install:"
echo "$packages" | sed 's/^/  - /'
echo ""

# Confirm installation
read -p "Do you want to proceed with the installation? (y/N) " -n 1 -r
echo
if [[ $REPLY =~ ^[Yy]$ ]]; then
    # Loop through and install each selected package
    for pkg in $packages; do
        echo -e "\n==> Installing $pkg..."
        brew install "$pkg"
    done
    echo -e "\n✨ Installation complete!"
else
    echo "Installation cancelled."
fi
